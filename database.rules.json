// Realtime Database rules for the visitor map.
//
// Paste into Firebase Console -> Realtime Database -> Rules, then Publish.
// (Comments are supported by the Firebase rules parser.)
//
// The client has to read the whole visitor list to draw the heatmap, so reads
// stay public. That is only acceptable because records no longer contain an IP
// address or precise coordinates -- and the validation below is what keeps it
// that way. It rejects any write that carries an extra field (such as "ip"),
// an oversized string, or an out-of-range coordinate, and it stops clients
// from editing or deleting records that already exist.
{
  "rules": {
    // Deny everything by default; open up only the visitors subtree.
    ".read": false,
    ".write": false,

    "visitors": {
      ".read": true,

      "$visitorId": {
        // Create-only: an existing record can never be modified or removed.
        ".write": "!data.exists() && newData.exists()",

        ".validate": "newData.hasChildren(['lat', 'lng', 'city', 'country', 'countryCode', 'timestamp'])",

        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "city": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "country": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "countryCode": {
          ".validate": "newData.isString() && newData.val().length <= 3"
        },
        "timestamp": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },

        // Anything not listed above (an "ip" field, for example) is rejected.
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
